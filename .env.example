# Aggregated backend mode
USE_THIRD_PARTY_MODELS=true
LOG_LEVEL=INFO
ML_BACKEND_PORT=9090
ML_BACKEND_IMAGE=opencsgs/lb-llm-back:v1.0.0
WORKERS=1
THREADS=8

# Doubao Seed runtime settings. API Key is supplied by Label Studio per request.
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TIMEOUT=360
DOUBAO_MAX_IMAGE_SIZE=640

# Volcengine EntitySegment runtime settings. AK/SK are supplied by Label Studio
# per request when the selected template requires segmentation.
VOLCENGINE_ENTITY_SEGMENT_MODEL=entity_seg
VOLCENGINE_ENTITY_SEGMENT_MAX_ENTITY=10
VOLCENGINE_ENTITY_SEGMENT_REFINE_MASK=1
VOLCENGINE_ENTITY_SEGMENT_RETURN_FORMAT=3

# Label Studio media access
# Required for images uploaded to Label Studio. Use the host directory that
# corresponds to Label Studio's /label-studio/data/media directory.
LABEL_STUDIO_LOCAL_MEDIA_ROOT=/absolute/path/to/label-studio/data/media
