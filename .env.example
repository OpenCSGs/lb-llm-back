# Aggregated backend mode
USE_THIRD_PARTY_MODELS=true
LOG_LEVEL=INFO
ML_BACKEND_PORT=9090
WORKERS=1
THREADS=8

# Doubao Seed (required by mask classification and OCR)
ARK_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TIMEOUT=360
DOUBAO_MAX_IMAGE_SIZE=640

# Volcengine EntitySegment (required by mask semantic segmentation)
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
VOLCENGINE_ENTITY_SEGMENT_MODEL=entity_seg
VOLCENGINE_ENTITY_SEGMENT_MAX_ENTITY=10
VOLCENGINE_ENTITY_SEGMENT_REFINE_MASK=1
VOLCENGINE_ENTITY_SEGMENT_RETURN_FORMAT=3
VOLCENGINE_ENTITY_SEGMENT_LABEL=

# Label Studio media access
LABEL_STUDIO_URL=http://host.docker.internal:8080
LABEL_STUDIO_LOCAL_MEDIA_ROOT=
LABEL_STUDIO_CONTAINER_MEDIA_ROOT=/label-studio-media
